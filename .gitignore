# Dependencies
node_modules/
.pnpm-store/

# Build and packaging output
out/
dist/
release/
.vite/
coverage/
*.tsbuildinfo
*.tgz

# Generated OCR runtime assets
# Recreate these with: pnpm assets:ocr
src/renderer/public/ocr/*
!src/renderer/public/ocr/.gitkeep
src/renderer/public/tessdata/*
!src/renderer/public/tessdata/.gitkeep

# Environment variables and secrets
.env
.env.*
!.env.example
*.p12
*.pfx
*.key
*.pem

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local debug data
.debug-user-data*/
.electron-builder-cache/

# Editors and IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
