{
  "name": "snapocr",
  "version": "0.1.0",
  "description": "A privacy-first, fully offline screen OCR utility for Windows, macOS, and Linux.",
  "main": "./out/main/index.js",
  "author": "SnapOCR contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "assets:ocr": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "node scripts/prepare-ocr-assets.mjs && electron-vite build && electron-builder --dir",
    "dist": "node scripts/prepare-ocr-assets.mjs && electron-vite build && electron-builder",
    "dist:win": "node scripts/prepare-ocr-assets.mjs && electron-vite build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-ocr-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "packageManager": "pnpm@11.19.0"
}